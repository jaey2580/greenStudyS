<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- <mapper namespace="user2NS"> -->
<mapper namespace="com.spring.greenStudyS.dao.GuestDAO">
 
	<select id="getGuestList" resultType="com.spring.greenStudyS.vo.GuestVO">
		select * from guest order by idx desc limit #{startIndexNo}, #{pageSize};
	</select>
 
	<select id="getGuestAdmin" resultType="com.spring.greenStudyS.vo.User2VO">
		select * from user2 where mid = 'admin';
	</select>
	
	<select id="getTotRecCnt" resultType="int">
		select count(*) from guest;
	</select>
	
	
	
	<insert id="setGuestInput">
		insert into guest values (default,#{vo.name},#{vo.content},#{vo.email},#{vo.homePage},#{vo.hostIp},default);
	</insert>
  
  
  
  
  
  <delete id="setGuestDelete">
    delete from guest where idx = #{idx};
  </delete>
  
</mapper>
<mapper namespace="com.spring.greenStudyS.dao.BoardDAO">
 
 <select id="getTotRecCnt" resultType="int">
 	select count(*) from board;
 </select>
 
 <select id="getBoardList" resultType="com.spring.greenStudyS.vo.BoardVO">
 	select * from board order by idx desc limit #{startIndexNo}, #{pageSize};
 </select>
 
</mapper>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- <mapper namespace="user2NS"> -->
<mapper namespace="com.spring.greenStudyS.dao.User2DAO">
  
  <select id="getUserList" resultType="com.spring.greenStudyS.vo.User2VO">
  	select * from user2 order by idx desc;
  </select>
  
  
  <!-- 
  <insert id="setUserJoin">
    insert into user2 values (default, #{vo.mid}, #{vo.pwd}, #{vo.name}, #{vo.age}, #{vo.gender}, #{vo.address});
  </insert>
   -->
  <insert id="setUserJoin" parameterType="user2VO">
    insert into user2 values (default, #{mid}, #{pwd}, #{name}, #{age}, #{gender}, #{address});
  </insert>
  
  <insert id="setUserInput">
    insert into user2 values (default, #{vo.mid}, #{vo.pwd}, #{vo.name}, #{vo.age}, #{vo.gender}, #{vo.address});
  </insert>
  
  
</mapper>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="userNS">
  
  <!-- <select id="getUserList" resultType="com.spring.greenStudyS.vo.UserVO"> -->
  <select id="getUserList" resultType="userVO">
    select * from user order by ${fieldName} ${orderName};
  </select>
  
  <select id="getUserSearch" resultType="userVO">
    select * from user where mid like concat('%',#{mid},'%') order by idx desc;
  </select>
  
  
  
  <insert id="setUserJoin">
  	insert into user values (default,#{mid},#{name},#{age},#{address});
  </insert>
  
  
  <delete id="setUserDelete">
  	delete from user where idx = #{idx}
  </delete>
  
</mapper>